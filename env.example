# ============================================================
# Aegean Consensus - Environment Configuration Template
# Copy: cp env.example .env  then fill in your values
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────────────
# At least one provider is required for LLM-powered validators.
# Without a key, validators fall back to rule-based pre-screen only
# (the system still works, but LLM deep analysis is disabled).
#
# Supported providers:
#
#   OpenAI          → set OPENAI_API_KEY (+ optionally OPENAI_BASE_URL)
#   Anthropic Claude→ set ANTHROPIC_API_KEY
#   Azure OpenAI    → set AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT
#   MiniMax         → set OPENAI_API_KEY + OPENAI_BASE_URL (OpenAI-compat)
#   Moonshot/Kimi   → set OPENAI_API_KEY + OPENAI_BASE_URL (OpenAI-compat)
#   DeepSeek        → set OPENAI_API_KEY + OPENAI_BASE_URL (OpenAI-compat)
#   Zhipu/GLM       → set OPENAI_API_KEY + OPENAI_BASE_URL (OpenAI-compat)
#   Any OpenAI-compatible endpoint → OPENAI_API_KEY + OPENAI_BASE_URL

# --- Option A: OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   # default, omit for standard OpenAI

# --- Option A2: Internal aggregator / proxy (e.g. Praka, any OpenAI-compatible) ---
# Use your company's aggregator platform by pointing OPENAI_BASE_URL at it.
# The aggregator wraps multiple providers under one OpenAI-compatible endpoint.
# OPENAI_API_KEY=sk-your-aggregator-key
# OPENAI_BASE_URL=https://praka.ai/v1
# OPENAI_MODEL=gpt-4o                  # or claude-3-5-sonnet-20240620, etc.

# --- Option B: OpenAI-compatible providers (MiniMax, Moonshot, DeepSeek, etc.) ---
# Set the same OPENAI_API_KEY variable with the provider's key,
# and point OPENAI_BASE_URL at their API endpoint.
#
# MiniMax example:
# OPENAI_API_KEY=your-minimax-api-key
# OPENAI_BASE_URL=https://api.minimax.chat/v1
# OPENAI_MODEL=abab6.5s-chat
#
# Moonshot / Kimi example:
# OPENAI_API_KEY=your-moonshot-api-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k
#
# DeepSeek example:
# OPENAI_API_KEY=your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# Zhipu / GLM example:
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4

# --- Option C: Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Option D: Azure OpenAI ---
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Agent Configuration ──────────────────────────────────────────────
AEGEAN_AGENT_COUNT=3          # number of concurrent agents
AEGEAN_QUORUM_SIZE=2          # quorum threshold alpha
AEGEAN_STABILITY_HORIZON=2    # stability horizon beta
AEGEAN_MAX_ROUNDS=5           # max refinement rounds

# ── Risk Assessment ──────────────────────────────────────────────────
RISK_SINGLE_LIMIT=50000             # hard limit per transaction
RISK_HOURLY_LIMIT=20000             # hourly aggregate limit
RISK_TRACE_REQUIRED_ABOVE=5000      # require trace_context above this amount
RISK_CHALLENGE_TTL_MINUTES=30       # challenge response timeout (minutes)
RISK_SESSION_TTL_HOURS=24           # session lifetime (hours)

# ── Storage Backend ──────────────────────────────────────────────────
# Use 'memory' for development. Switch to milvus/timescaledb for production.
KNOWLEDGE_BACKEND=memory      # memory | milvus | pinecone
EXPERIENCE_BACKEND=memory     # memory | timescaledb | postgresql

# Milvus (production knowledge base)
# MILVUS_HOST=milvus
# MILVUS_PORT=19530

# PostgreSQL / TimescaleDB (production experience base)
# DATABASE_URL=postgresql://aegean:aegean_secret@postgres:5432/aegean

# ── API Server ────────────────────────────────────────────────────────
AEGEAN_HOST=0.0.0.0
AEGEAN_PORT=8000
AEGEAN_WORKERS=1
AEGEAN_RELOAD=false
AEGEAN_LOG_LEVEL=INFO
